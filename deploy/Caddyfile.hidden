#
# Caddyfile.hidden — Life-OS mounted under a SECRET path prefix.
#
# Used instead of deploy/Caddyfile when LIFE_OS_HUB_PREFIX is set in .env, so
# the domain root is free for a separate public site and the hub is reachable
# only at mindlathe.xyz/<prefix>/…  (secret paths aren't published in
# Certificate Transparency logs, unlike a subdomain would be).
#
# install-services.sh substitutes __DOMAIN__ and __HUB_PREFIX__.
# The app must run with LIFE_OS_HUB_PREFIX=<prefix> so its links/redirects match.
#

www.__DOMAIN__ {
    redir https://__DOMAIN__{uri} permanent
}

__DOMAIN__ {
    encode gzip zstd

    # The React hub (life-os-web) — a STATIC bundle at <prefix>/app/*, no Node
    # runtime on this box. MUST precede the catch-all hub proxy below: these are
    # mutually exclusive handlers and the more specific subtree has to win, or
    # every asset request would be proxied to FastAPI and 404.
    #
    # try_files → index.html is safe HERE (unlike at the domain root) because it
    # is scoped to the <prefix>/app/ subtree, which FastAPI does not own — so it
    # cannot shadow /api, /login, /health or any Jinja page.
    #
    # The bundle itself is served unauthenticated; that is the normal SPA shape
    # and leaks nothing, because every byte of DATA it renders comes from
    # /api/* behind the session gate (a logged-out visitor gets a shell that
    # immediately 401s to the login page). Source maps are deliberately not
    # deployed — see deploy/bin/deploy-web.sh.
    handle_path __HUB_PREFIX__/app/* {
        root * /srv/life-os-web
        try_files {path} /index.html
        file_server
    }

    # The Jinja hub — strip the secret prefix, then proxy. The app knows its
    # external prefix (LIFE_OS_HUB_PREFIX) so its own links stay correct.
    handle_path __HUB_PREFIX__/* {
        reverse_proxy localhost:8000
    }

    # Bare /health keeps the exact response it had before the public site
    # landed (the old root placeholder), so nothing that pings it changes.
    # The app's real health probe is <prefix>/health, above. mind-lathe's
    # NEEDS.md reserves /health; its links gate keeps dist/ from claiming it.
    handle /health {
        header Content-Type "text/html; charset=utf-8"
        respond "<!doctype html><meta charset=utf-8><title>mindlathe</title><body style='font:16px system-ui;display:grid;place-items:center;height:90vh;margin:0;color:#555'>Coming soon.</body>" 200
    }

    # Root + everything else: the PUBLIC site (mind-lathe repo), a static dist/
    # published to /srv/mind-lathe by deploy/bin/deploy-site.sh. Today that is
    # the Culture holding page (mind-lathe IR-2, D31); IR-1 later swaps the
    # directory's CONTENTS for the ratified site — this block should not change.
    # No try_files: a SPA fallback here would answer every unknown path with
    # 200, shadowing reserved paths (mind-lathe NEEDS.md item 3). Unknown → 404.
    handle {
        root * /srv/mind-lathe
        file_server
    }

    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 10
        }
        format console
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        Referrer-Policy           "strict-origin-when-cross-origin"
        -Server
    }
}
